# Copy file này thành ".env" rồi sửa giá trị. Dòng bắt đầu bằng # là ghi chú.

# Mật khẩu trang quản lý (bỏ trống = tự tạo, xem trong data\admin-password.txt)
ADMIN_PASSWORD=

# Cổng chạy server
PORT=3456

# Địa chỉ public (khi có tên miền/tunnel cố định), vd https://chonanh.tenmien.com
# Bỏ trống nếu dùng tunnel tạm — khi đó hãy mở trang quản lý bằng chính địa chỉ tunnel.
PUBLIC_URL=

# (Tuỳ chọn) Google Drive API key — đọc thư mục lớn ổn định hơn
GOOGLE_API_KEY=
